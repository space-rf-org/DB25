-- logical
(Project :exprs ((colref 0 :tid 3 :cid 2 :type Text :null t) (colref 1 :type Double :null t)) :out ((dept Text :null t :tid 3 :cid 2) (SUM Double :null t))
  (Aggregate :keys ((colref 1 :tid 3 :cid 2 :type Text :null t)) :aggs ((agg SUM (colref 3 :tid 3 :cid 4 :type Double :null t) :filter (subquery :kind exists :correlated :type Boolean :null f) :type Double :null t)) :out ((dept Text :null t :alias emp :tid 3 :cid 2) (SUM Double :null t))
    (subplan
      (Project :exprs ((lit 1 :type Integer :null f)) :out ((1 Integer :null f))
        (Filter :pred (binop "=" (colref 0 :tid 1 :cid 1 :type Integer :null f) (outerref 0 :depth 1 :tid 3 :cid 1 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))
