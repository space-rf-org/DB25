-- physical
(Project exprs=[(col #0) (col #1)] out=[dept:Text? SUM:Double?]
  (HashAggregate keys=[(col #1)] aggs=[(SUM (col #3) :filter (Subquery))] out=[dept:Text? SUM:Double?]
    (SeqScan table=emp fmt=row out=[id:Integer dept:Text? region:Text? salary:Double?])))

