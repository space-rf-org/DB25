                (IntegerLiteral :text 1))
              (FromClause
                (TableRef :text users))
              (WhereClause
                (BinaryExpr :text "="
                  (ColumnRef :text "users.id")
                  (ColumnRef :text "emp.id")))))))))
  (FromClause
    (TableRef :text emp))
  (GroupByClause
    (ColumnRef :text dept)))

