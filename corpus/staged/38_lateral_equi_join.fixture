-- physical
(Project exprs=[(col #1) (col #3)] out=[name:VarChar? total:Double?]
  (NestedLoopJoin kind=leftlateral keys=[(L#0 R#0)] out=[id:Integer name:VarChar? user_id:Integer? total:Double?]
