(Project :exprs ((colref 1 :tid 1 :cid 2 :type VarChar :null t) (colref 3 :tid 2 :cid 3 :type Double :null t)) :out ((name VarChar :null t :tid 1 :cid 2) (total Double :null t :tid 2 :cid 3))
  (Join :kind leftlateral :pred (binop "=" (colref 0 :tid 1 :cid 1 :type Integer :null f) (colref 2 :tid 2 :cid 2 :type Integer :null t) :type Boolean :null t) :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2) (user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
    (Scan :rel users :alias u :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2)))
    (Project :exprs ((colref 1 :tid 2 :cid 2 :type Integer :null t) (colref 2 :tid 2 :cid 3 :type Double :null t)) :out ((user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
      (Filter :pred (binop "=" (colref 1 :tid 2 :cid 2 :type Integer :null t) (outerref 0 :depth 1 :tid 1 :cid 1 :type Integer :null f) :type Boolean :null t) :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3))
