-- sql
INSERT INTO users (id, name) SELECT id, name FROM users WHERE id > 10 RETURNING id

-- tokens
(tokens
  (kw INSERT 0 6)
  (kw INTO 7 11)
  (ident users 12 17)
  (punct "(" 18 19)
  (ident id 19 21)
  (punct "," 21 22)
  (ident name 23 27)
  (punct ")" 27 28)
  (kw SELECT 29 35)
  (ident id 36 38)
  (punct "," 38 39)
  (ident name 40 44)
  (kw FROM 45 49)
  (ident users 50 55)
  (kw WHERE 56 61)
  (ident id 62 64)
  (op ">" 65 66)
  (num 10 67 69)
  (kw RETURNING 70 79)
  (ident id 80 82)
  (eof 82 82))

-- ast
(InsertStmt
  (TableRef :text users)
  (ColumnList
    (Identifier :text id)
    (Identifier :text name))
  (SelectStmt
    (SelectList
      (ColumnRef :text id)
      (ColumnRef :text name))
    (FromClause
      (TableRef :text users))
    (WhereClause
      (BinaryExpr :text ">"
        (ColumnRef :text id)
        (IntegerLiteral :text 10))))
  (ReturningClause
    (Identifier :text id)))

-- resolved
(InsertStmt
  (TableRef :text users)
  (ColumnList
    (Identifier :text id)
    (Identifier :text name))
  (SelectStmt
    (SelectList
      (ColumnRef :text id :type Integer :null f :tid 1 :cid 1)
      (ColumnRef :text name :type VarChar :null t :tid 1 :cid 2))
    (FromClause
      (TableRef :text users))
    (WhereClause
      (BinaryExpr :text ">" :type Boolean :null f
        (ColumnRef :text id :type Integer :null f :tid 1 :cid 1)
        (IntegerLiteral :text 10 :type Integer :null f))))
  (ReturningClause
    (Identifier :text id :type Integer :null f :tid 1 :cid 1)))

-- logical
(Returning :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null f)) :out ((id Integer :null f :tid 1 :cid 1))
  (Insert :table users :cols (id name) :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))
    (Project :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null f) (colref 1 :tid 1 :cid 2 :type VarChar :null t)) :out ((id Integer :null f :tid 1 :cid 1) (name VarChar :null t :tid 1 :cid 2))
      (Filter :pred (binop ">" (colref 0 :tid 1 :cid 1 :type Integer :null f) (lit 10 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))
        (Scan :rel users :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2)))))))

-- optimized
(Returning :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null f)) :out ((id Integer :null f :tid 1 :cid 1))
  (Insert :table users :cols (id name) :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))
    (Project :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null f) (colref 1 :tid 1 :cid 2 :type VarChar :null t)) :out ((id Integer :null f :tid 1 :cid 1) (name VarChar :null t :tid 1 :cid 2))
      (Filter :pred (binop ">" (colref 0 :tid 1 :cid 1 :type Integer :null f) (lit 10 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))
        (Scan :rel users :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2)))))))

-- physical
(Project exprs=[(col #0)] out=[id:Integer]
  (Insert table=users cols=[id name] out=[id:Integer name:VarChar?]
    (Project exprs=[(col #0) (col #1)] out=[id:Integer name:VarChar?]
      (Filter pred=(> (col #0) (lit 10)) out=[id:Integer name:VarChar?]
        (SeqScan table=users fmt=row out=[id:Integer name:VarChar?])))))

