-- sql
SELECT INTERVAL '1 day'

-- tokens
(tokens
  (kw SELECT 0 6)
  (kw INTERVAL 7 15)
  (str "'1 day'" 16 23)
  (eof 23 23))

-- ast
(SelectStmt
  (SelectList
    (IntervalLiteral :text "'1 day'"
      (StringLiteral :text "'1 day'"))))

-- resolved
(SelectStmt
  (SelectList
    (IntervalLiteral :text "'1 day'" :type Interval :null f
      (StringLiteral :text "'1 day'"))))

-- logical
(Project :exprs ((lit "1 day" :type Interval :null f)) :out (("'1 day'" Interval :null f))
  (Values :rows (()) :out ()))

-- optimized
(Project :exprs ((lit "1 day" :type Interval :null f)) :out (("'1 day'" Interval :null f))
  (Values :rows (()) :out ()))

-- physical
(Project exprs=[(lit '1 day')] out=['1 day':Interval]
  (ValuesScan rows=[] out=[]))

