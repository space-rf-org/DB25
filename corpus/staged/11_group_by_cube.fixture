  (Aggregate :keys ((colref 0 :tid 3 :cid 2 :type Text :null t) (colref 1 :tid 3 :cid 3 :type Text :null t)) :aggs ((agg SUM (colref 2 :tid 3 :cid 4 :type Double :null t) :type Double :null t)) :gsets ((0 1) (1) (0) ()) :out ((dept Text :null t :alias emp :tid 3 :cid 2) (region Text :null t :alias emp :tid 3 :cid 3) (SUM Double :null t))
    (Scan :rel emp :out ((dept Text :null t :alias emp :tid 3 :cid 2) (region Text :null t :alias emp :tid 3 :cid 3) (salary Double :null t :alias emp :tid 3 :cid 4)))))

