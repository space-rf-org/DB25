-- sql
SELECT EXTRACT(YEAR FROM CURRENT_DATE)

-- tokens
(tokens
  (kw SELECT 0 6)
  (kw EXTRACT 7 14)
  (punct "(" 14 15)
  (ident YEAR 15 19)
  (kw FROM 20 24)
  (ident CURRENT_DATE 25 37)
  (punct ")" 37 38)
  (eof 38 38))

-- ast
(SelectStmt
  (SelectList
    (FunctionCall :text EXTRACT
      (Identifier :text YEAR)
      (FunctionCall :text CURRENT_DATE))))

-- resolved
(SelectStmt
  (SelectList
    (FunctionCall :text EXTRACT :type Double :null f
      (Identifier :text YEAR)
      (FunctionCall :text CURRENT_DATE :type Date :null f))))

-- logical
(Project :exprs ((func EXTRACT (lit YEAR :type Text :null f) (func CURRENT_DATE :type Date :null f) :type Double :null f)) :out ((EXTRACT Double :null f))
  (Values :rows 1 :out ()))

-- optimized
(Project :exprs ((func EXTRACT (lit YEAR :type Text :null f) (func CURRENT_DATE :type Date :null f) :type Double :null f)) :out ((EXTRACT Double :null f))
  (Values :rows 1 :out ()))

-- physical
(Project exprs=[(EXTRACT (lit 'YEAR') (CURRENT_DATE))] out=[EXTRACT:Double]
  (ValuesScan rows=[] out=[]))

