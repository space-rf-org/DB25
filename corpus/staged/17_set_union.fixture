-- sql
SELECT id FROM users UNION SELECT user_id FROM orders

-- tokens
(tokens
  (kw SELECT 0 6)
  (ident id 7 9)
  (kw FROM 10 14)
  (ident users 15 20)
  (kw UNION 21 26)
  (kw SELECT 27 33)
  (ident user_id 34 41)
  (kw FROM 42 46)
  (ident orders 47 53)
  (eof 53 53))

-- ast
(UnionStmt :text UNION
  (SelectStmt
    (SelectList
      (ColumnRef :text id))
    (FromClause
      (TableRef :text users)))
  (SelectStmt
    (SelectList
      (ColumnRef :text user_id))
    (FromClause
      (TableRef :text orders))))

-- resolved
(UnionStmt :text UNION
  (SelectStmt
    (SelectList
      (ColumnRef :text id :type Integer :null f :tid 1 :cid 1))
    (FromClause
      (TableRef :text users)))
  (SelectStmt
    (SelectList
      (ColumnRef :text user_id :type Integer :null t :tid 2 :cid 2))
    (FromClause
      (TableRef :text orders))))

-- logical
(SetOp :op union :out ((id Integer :null t :tid 1 :cid 1))
  (Project :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null f)) :out ((id Integer :null f :tid 1 :cid 1))
    (Scan :rel users :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))))
  (Project :exprs ((colref 1 :tid 2 :cid 2 :type Integer :null t)) :out ((user_id Integer :null t :tid 2 :cid 2))
    (Scan :rel orders :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3)))))

-- optimized
(SetOp :op union :out ((id Integer :null t :tid 1 :cid 1))
  (Project :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null f)) :out ((id Integer :null f :tid 1 :cid 1))
    (Scan :rel users :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))))
  (Project :exprs ((colref 1 :tid 2 :cid 2 :type Integer :null t)) :out ((user_id Integer :null t :tid 2 :cid 2))
    (Scan :rel orders :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3)))))

