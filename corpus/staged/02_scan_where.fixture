-- sql
SELECT id, name FROM users WHERE id = 1

-- logical
(Project :exprs ((colref 0 :type Integer :null f) (colref 1 :type VarChar :null t)) :out ((id Integer :null f) (name VarChar :null t))
  (Filter :pred (binop "=" (colref 0 :type Integer :null f) (lit 1 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias users) (name VarChar :null t :alias users))
    (Scan :rel users :out ((id Integer :null f :alias users) (name VarChar :null t :alias users)))))

-- optimized
(Project :exprs ((colref 0 :type Integer :null f) (colref 1 :type VarChar :null t)) :out ((id Integer :null f) (name VarChar :null t))
  (Filter :pred (binop "=" (colref 0 :type Integer :null f) (lit 1 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias users) (name VarChar :null t :alias users))
    (Scan :rel users :out ((id Integer :null f :alias users) (name VarChar :null t :alias users)))))

