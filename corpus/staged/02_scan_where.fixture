-- sql
SELECT id, name FROM users WHERE id = 1

-- logical
(Project :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null f) (colref 1 :tid 1 :cid 2 :type VarChar :null t)) :out ((id Integer :null f :tid 1 :cid 1) (name VarChar :null t :tid 1 :cid 2))
  (Filter :pred (binop "=" (colref 0 :tid 1 :cid 1 :type Integer :null f) (lit 1 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))
    (Scan :rel users :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2)))))

-- optimized
(Project :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null f) (colref 1 :tid 1 :cid 2 :type VarChar :null t)) :out ((id Integer :null f :tid 1 :cid 1) (name VarChar :null t :tid 1 :cid 2))
  (Filter :pred (binop "=" (colref 0 :tid 1 :cid 1 :type Integer :null f) (lit 1 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))
    (Scan :rel users :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2)))))

-- ast
(SelectStmt
  (SelectList
    (ColumnRef :text id)
    (ColumnRef :text name))
  (FromClause
    (TableRef :text users))
  (WhereClause
    (BinaryExpr :text "="
      (ColumnRef :text id)
      (IntegerLiteral :text 1))))

-- resolved
(SelectStmt
  (SelectList
    (ColumnRef :text id :type Integer :null f :tid 1 :cid 1)
    (ColumnRef :text name :type VarChar :null t :tid 1 :cid 2))
  (FromClause
    (TableRef :text users))
  (WhereClause
    (BinaryExpr :text "=" :type Boolean :null f
      (ColumnRef :text id :type Integer :null f :tid 1 :cid 1)
      (IntegerLiteral :text 1 :type Integer :null f))))

-- tokens
(tokens
  (kw SELECT 0 6)
  (ident id 7 9)
  (punct "," 9 10)
  (ident name 11 15)
  (kw FROM 16 20)
  (ident users 21 26)
  (kw WHERE 27 32)
  (ident id 33 35)
  (op "=" 36 37)
  (num 1 38 39)
  (eof 39 39))

-- physical
(Project exprs=[(col #0) (col #1)] out=[id:Integer name:VarChar?]
  (Filter pred=(= (col #0) (lit 1)) out=[id:Integer name:VarChar?]
    (SeqScan table=users fmt=row out=[id:Integer name:VarChar?])))

