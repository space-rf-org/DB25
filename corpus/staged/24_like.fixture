  (eof 41 41))

-- ast
(SelectStmt
  (SelectList
    (ColumnRef :text id))
  (FromClause
    (TableRef :text emp))
  (WhereClause
    (LikeExpr :text LIKE
      (ColumnRef :text dept)
      (StringLiteral :text "'eng%'"))))

-- resolved
(SelectStmt
  (SelectList
    (ColumnRef :text id :type Integer :null f :tid 3 :cid 1))
  (FromClause
    (TableRef :text emp))
  (WhereClause
    (LikeExpr :text LIKE :type Boolean :null t
      (ColumnRef :text dept :type Text :null t :tid 3 :cid 2)
      (StringLiteral :text "'eng%'" :type Text :null f))))

-- logical
(Project :exprs ((colref 0 :type Integer :null f)) :out ((id Integer :null f))
  (Filter :pred (like (colref 1 :type Text :null t) (lit "eng%" :type Text :null f) :type Boolean :null t) :out ((id Integer :null f :alias emp) (dept Text :null t :alias emp) (region Text :null t :alias emp) (salary Double :null t :alias emp))
    (Scan :rel emp :out ((id Integer :null f :alias emp) (dept Text :null t :alias emp) (region Text :null t :alias emp) (salary Double :null t :alias emp)))))

