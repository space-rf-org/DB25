-- sql
SELECT dept COLLATE "C" FROM emp

-- tokens
(tokens
  (kw SELECT 0 6)
  (ident dept 7 11)
  (kw COLLATE 12 19)
  (ident C 21 22)
  (kw FROM 24 28)
  (ident emp 29 32)
  (eof 32 32))

-- ast
(SelectStmt
  (SelectList
    (CollateClause :text COLLATE :qual C
      (ColumnRef :text dept)))
  (FromClause
    (TableRef :text emp)))

-- resolved
(SelectStmt
  (SelectList
    (CollateClause :text COLLATE :qual C :type Text :null t
      (ColumnRef :text dept :type Text :null t :tid 3 :cid 2)))
  (FromClause
    (TableRef :text emp)))

-- logical
(Project :exprs ((func COLLATE (colref 1 :tid 3 :cid 2 :type Text :null t) (lit C :type Text :null f) :type Text :null t)) :out ((C Text :null t))
  (Scan :rel emp :out ((id Integer :null f :alias emp :tid 3 :cid 1) (dept Text :null t :alias emp :tid 3 :cid 2) (region Text :null t :alias emp :tid 3 :cid 3) (salary Double :null t :alias emp :tid 3 :cid 4))))

-- optimized
(Project :exprs ((func COLLATE (colref 0 :tid 3 :cid 2 :type Text :null t) (lit C :type Text :null f) :type Text :null t)) :out ((C Text :null t))
  (Scan :rel emp :out ((dept Text :null t :alias emp :tid 3 :cid 2))))

-- physical
(Project exprs=[(COLLATE (col #0) (lit 'C'))] out=[C:Text?]
  (SeqScan table=emp fmt=row out=[dept:Text?]))

