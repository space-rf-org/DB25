-- sql
SELECT u.id, o.total FROM users u FULL JOIN orders o ON u.id = o.user_id

-- tokens
(tokens
  (kw SELECT 0 6)
  (ident u 7 8)
  (op "." 8 9)
  (ident id 9 11)
  (punct "," 11 12)
  (ident o 13 14)
  (op "." 14 15)
  (ident total 15 20)
  (kw FROM 21 25)
  (ident users 26 31)
  (ident u 32 33)
  (kw FULL 34 38)
  (kw JOIN 39 43)
  (ident orders 44 50)
  (ident o 51 52)
  (kw ON 53 55)
  (ident u 56 57)
  (op "." 57 58)
  (ident id 58 60)
  (op "=" 61 62)
  (ident o 63 64)
  (op "." 64 65)
  (ident user_id 65 72)
  (eof 72 72))

-- ast
(SelectStmt
  (SelectList
    (ColumnRef :text "u.id")
    (ColumnRef :text "o.total"))
  (FromClause
    (TableRef :text users :qual u)
    (JoinClause :text "FULL JOIN"
      (TableRef :text orders :qual o)
      (BinaryExpr :text "="
        (ColumnRef :text "u.id")
        (ColumnRef :text "o.user_id")))))

-- resolved
(SelectStmt
  (SelectList
    (ColumnRef :text "u.id" :type Integer :null t :tid 1 :cid 1)
    (ColumnRef :text "o.total" :type Double :null t :tid 2 :cid 3))
  (FromClause
    (TableRef :text users :qual u)
    (JoinClause :text "FULL JOIN"
      (TableRef :text orders :qual o)
      (BinaryExpr :text "=" :type Boolean :null t
        (ColumnRef :text "u.id" :type Integer :null t :tid 1 :cid 1)
        (ColumnRef :text "o.user_id" :type Integer :null t :tid 2 :cid 2)))))

-- logical
(Project :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null t) (colref 4 :tid 2 :cid 3 :type Double :null t)) :out ((id Integer :null t :tid 1 :cid 1) (total Double :null t :tid 2 :cid 3))
  (Join :kind full :pred (binop "=" (colref 0 :tid 1 :cid 1 :type Integer :null t) (colref 3 :tid 2 :cid 2 :type Integer :null t) :type Boolean :null t) :out ((id Integer :null t :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2) (id Integer :null t :alias o :tid 2 :cid 1) (user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
    (Scan :rel users :alias u :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2)))
    (Scan :rel orders :alias o :out ((id Integer :null f :alias o :tid 2 :cid 1) (user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3)))))

-- optimized
(Project :exprs ((colref 0 :tid 1 :cid 1 :type Integer :null t) (colref 2 :tid 2 :cid 3 :type Double :null t)) :out ((id Integer :null t :tid 1 :cid 1) (total Double :null t :tid 2 :cid 3))
  (Join :kind full :pred (binop "=" (colref 0 :tid 1 :cid 1 :type Integer :null t) (colref 1 :tid 2 :cid 2 :type Integer :null t) :type Boolean :null t) :out ((id Integer :null t :alias u :tid 1 :cid 1) (user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
    (Scan :rel users :alias u :out ((id Integer :null f :alias u :tid 1 :cid 1)))
    (Scan :rel orders :alias o :out ((user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3)))))

-- physical
(Project exprs=[(col #0) (col #2)] out=[id:Integer? total:Double?]
  (HashJoin kind=full keys=[(L#0 R#0)] out=[id:Integer? user_id:Integer? total:Double?]
    (SeqScan table=users fmt=row out=[id:Integer])
    (SeqScan table=orders fmt=row out=[user_id:Integer? total:Double?])))

