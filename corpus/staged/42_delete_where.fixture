-- sql
DELETE FROM orders WHERE total > 500

-- tokens
(tokens
  (kw DELETE 0 6)
  (kw FROM 7 11)
  (ident orders 12 18)
  (kw WHERE 19 24)
  (ident total 25 30)
  (op ">" 31 32)
  (num 500 33 36)
  (eof 36 36))

-- ast
(DeleteStmt
  (TableRef :text orders)
  (WhereClause
    (BinaryExpr :text ">"
      (ColumnRef :text total)
      (IntegerLiteral :text 500))))

-- resolved
(DeleteStmt
  (TableRef :text orders)
  (WhereClause
    (BinaryExpr :text ">" :type Boolean :null t
      (ColumnRef :text total :type Double :null t :tid 2 :cid 3)
      (IntegerLiteral :text 500 :type Integer :null f))))

-- logical
(Delete :table orders :out ()
  (Filter :pred (binop ">" (colref 2 :tid 2 :cid 3 :type Double :null t) (lit 500 :type Integer :null f) :type Boolean :null t) :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3))
    (Scan :rel orders :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3)))))

-- optimized
(Delete :table orders :out ()
  (Filter :pred (binop ">" (colref 2 :tid 2 :cid 3 :type Double :null t) (lit 500 :type Integer :null f) :type Boolean :null t) :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3))
    (Scan :rel orders :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3)))))

-- physical
(Delete table=orders out=[]
  (Filter pred=(> (col #2) (lit 500)) out=[id:Integer user_id:Integer? total:Double?]
    (SeqScan table=orders fmt=row out=[id:Integer user_id:Integer? total:Double?])))

