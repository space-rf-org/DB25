  (FromClause
    (TableRef :text emp)))

-- logical
(Distinct :out ((dept Text :null t))
  (Project :exprs ((colref 1 :type Text :null t)) :out ((dept Text :null t))
    (Scan :rel emp :out ((id Integer :null f :alias emp) (dept Text :null t :alias emp) (region Text :null t :alias emp) (salary Double :null t :alias emp)))))

-- optimized
(Distinct :out ((dept Text :null t))
