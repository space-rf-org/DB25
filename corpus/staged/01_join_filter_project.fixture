-- sql
SELECT u.name, o.total FROM users u JOIN orders o ON o.user_id = u.id WHERE u.id = 42

-- logical
(Project :exprs ((colref 1 :tid 1 :cid 2 :type VarChar :null t) (colref 4 :tid 2 :cid 3 :type Double :null t)) :out ((name VarChar :null t :tid 1 :cid 2) (total Double :null t :tid 2 :cid 3))
  (Filter :pred (binop "=" (colref 0 :tid 1 :cid 1 :type Integer :null f) (lit 42 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2) (id Integer :null f :alias o :tid 2 :cid 1) (user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
    (Join :kind inner :pred (binop "=" (colref 3 :tid 2 :cid 2 :type Integer :null t) (colref 0 :tid 1 :cid 1 :type Integer :null f) :type Boolean :null t) :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2) (id Integer :null f :alias o :tid 2 :cid 1) (user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
      (Scan :rel users :alias u :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2)))
      (Scan :rel orders :alias o :out ((id Integer :null f :alias o :tid 2 :cid 1) (user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))))))

-- optimized
(Project :exprs ((colref 1 :tid 1 :cid 2 :type VarChar :null t) (colref 3 :tid 2 :cid 3 :type Double :null t)) :out ((name VarChar :null t :tid 1 :cid 2) (total Double :null t :tid 2 :cid 3))
  (Join :kind inner :pred (binop "=" (colref 2 :tid 2 :cid 2 :type Integer :null t) (colref 0 :tid 1 :cid 1 :type Integer :null f) :type Boolean :null t) :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2) (user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
    (Filter :pred (binop "=" (colref 0 :tid 1 :cid 1 :type Integer :null f) (lit 42 :type Integer :null f) :type Boolean :null f) :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2))
      (Scan :rel users :alias u :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2))))
    (Scan :rel orders :alias o :out ((user_id Integer :null t :alias o :tid 2 :cid 2) (total Double :null t :alias o :tid 2 :cid 3)))))

-- ast
(SelectStmt
  (SelectList
    (ColumnRef :text "u.name")
    (ColumnRef :text "o.total"))
  (FromClause
    (TableRef :text users :qual u)
    (JoinClause :text JOIN
      (TableRef :text orders :qual o)
      (BinaryExpr :text "="
        (ColumnRef :text "o.user_id")
        (ColumnRef :text "u.id"))))
  (WhereClause
    (BinaryExpr :text "="
      (ColumnRef :text "u.id")
      (IntegerLiteral :text 42))))

-- resolved
(SelectStmt
  (SelectList
    (ColumnRef :text "u.name" :type VarChar :null t :tid 1 :cid 2)
    (ColumnRef :text "o.total" :type Double :null t :tid 2 :cid 3))
  (FromClause
    (TableRef :text users :qual u)
    (JoinClause :text JOIN
      (TableRef :text orders :qual o)
      (BinaryExpr :text "=" :type Boolean :null t
        (ColumnRef :text "o.user_id" :type Integer :null t :tid 2 :cid 2)
        (ColumnRef :text "u.id" :type Integer :null f :tid 1 :cid 1))))
  (WhereClause
    (BinaryExpr :text "=" :type Boolean :null f
      (ColumnRef :text "u.id" :type Integer :null f :tid 1 :cid 1)
      (IntegerLiteral :text 42 :type Integer :null f))))

-- tokens
(tokens
  (kw SELECT 0 6)
  (ident u 7 8)
  (op "." 8 9)
  (ident name 9 13)
  (punct "," 13 14)
  (ident o 15 16)
  (op "." 16 17)
  (ident total 17 22)
  (kw FROM 23 27)
  (ident users 28 33)
  (ident u 34 35)
  (kw JOIN 36 40)
  (ident orders 41 47)
  (ident o 48 49)
  (kw ON 50 52)
  (ident o 53 54)
  (op "." 54 55)
  (ident user_id 55 62)
  (op "=" 63 64)
  (ident u 65 66)
  (op "." 66 67)
  (ident id 67 69)
  (kw WHERE 70 75)
  (ident u 76 77)
  (op "." 77 78)
  (ident id 78 80)
  (op "=" 81 82)
  (num 42 83 85)
  (eof 85 85))

-- physical
(Project exprs=[(col #1) (col #3)] out=[name:VarChar? total:Double?]
  (HashJoin keys=[(L#0 R#0)] out=[id:Integer name:VarChar? user_id:Integer? total:Double?]
    (Filter pred=(= (col #0) (lit 42)) out=[id:Integer name:VarChar?]
      (SeqScan table=users fmt=row out=[id:Integer name:VarChar?]))
    (SeqScan table=orders fmt=row out=[user_id:Integer? total:Double?])))

