-- physical
(Project exprs=[(col #0) (col #1)] out=[name:VarChar? total:Double?]
  (HashJoin keys=[] out=[name:VarChar? total:Double?]
    (SeqScan table=users fmt=row out=[name:VarChar?])
    (Project exprs=[(col #1)] out=[total:Double?]
