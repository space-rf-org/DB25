-- sql
SELECT u.name, o.total FROM users u CROSS JOIN LATERAL (SELECT total FROM orders WHERE user_id = u.id) o

-- tokens
(tokens
  (kw SELECT 0 6)
  (ident u 7 8)
  (op "." 8 9)
  (ident name 9 13)
  (punct "," 13 14)
  (ident o 15 16)
  (op "." 16 17)
  (ident total 17 22)
  (kw FROM 23 27)
  (ident users 28 33)
  (ident u 34 35)
  (kw CROSS 36 41)
  (kw JOIN 42 46)
  (kw LATERAL 47 54)
  (punct "(" 55 56)
  (kw SELECT 56 62)
  (ident total 63 68)
  (kw FROM 69 73)
  (ident orders 74 80)
  (kw WHERE 81 86)
  (ident user_id 87 94)
  (op "=" 95 96)
  (ident u 97 98)
  (op "." 98 99)
  (ident id 99 101)
  (punct ")" 101 102)
  (ident o 103 104)
  (eof 104 104))

-- ast
(SelectStmt
  (SelectList
    (ColumnRef :text "u.name")
    (ColumnRef :text "o.total"))
  (FromClause
    (TableRef :text users :qual u)
    (LateralJoin :text "CROSS JOIN"
      (Subquery :qual o
        (SelectStmt
          (SelectList
            (ColumnRef :text total))
          (FromClause
            (TableRef :text orders))
          (WhereClause
            (BinaryExpr :text "="
              (ColumnRef :text user_id)
              (ColumnRef :text "u.id"))))))))

-- resolved
(SelectStmt
  (SelectList
    (ColumnRef :text "u.name" :type VarChar :null t :tid 1 :cid 2)
    (ColumnRef :text "o.total" :type Double :null t :tid 2 :cid 3))
  (FromClause
    (TableRef :text users :qual u)
    (LateralJoin :text "CROSS JOIN"
      (Subquery :qual o
        (SelectStmt
          (SelectList
            (ColumnRef :text total :type Double :null t :tid 2 :cid 3))
          (FromClause
            (TableRef :text orders))
          (WhereClause
            (BinaryExpr :text "=" :type Boolean :null t
              (ColumnRef :text user_id :type Integer :null t :tid 2 :cid 2)
              (ColumnRef :text "u.id" :type Integer :null f :tid 1 :cid 1))))))))

-- logical
(Project :exprs ((colref 1 :tid 1 :cid 2 :type VarChar :null t) (colref 2 :tid 2 :cid 3 :type Double :null t)) :out ((name VarChar :null t :tid 1 :cid 2) (total Double :null t :tid 2 :cid 3))
  (Join :kind lateral :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
    (Scan :rel users :alias u :out ((id Integer :null f :alias u :tid 1 :cid 1) (name VarChar :null t :alias u :tid 1 :cid 2)))
    (Project :exprs ((colref 2 :tid 2 :cid 3 :type Double :null t)) :out ((total Double :null t :alias o :tid 2 :cid 3))
      (Filter :pred (binop "=" (colref 1 :tid 2 :cid 2 :type Integer :null t) (outerref 0 :depth 1 :tid 1 :cid 1 :type Integer :null f) :type Boolean :null t) :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3))
        (Scan :rel orders :out ((id Integer :null f :alias orders :tid 2 :cid 1) (user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3)))))))

-- optimized
(Project :exprs ((colref 0 :tid 1 :cid 2 :type VarChar :null t) (colref 1 :tid 2 :cid 3 :type Double :null t)) :out ((name VarChar :null t :tid 1 :cid 2) (total Double :null t :tid 2 :cid 3))
  (Join :kind lateral :out ((name VarChar :null t :alias u :tid 1 :cid 2) (total Double :null t :alias o :tid 2 :cid 3))
    (Scan :rel users :alias u :out ((name VarChar :null t :alias u :tid 1 :cid 2)))
    (Project :exprs ((colref 1 :tid 2 :cid 3 :type Double :null t)) :out ((total Double :null t :alias o :tid 2 :cid 3))
      (Filter :pred (binop "=" (colref 0 :tid 2 :cid 2 :type Integer :null t) (outerref 0 :depth 1 :tid 1 :cid 1 :type Integer :null f) :type Boolean :null t) :out ((user_id Integer :null t :alias orders :tid 2 :cid 2) (total Double :null t :alias orders :tid 2 :cid 3))
