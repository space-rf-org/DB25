  (Filter :pred (binop AND (subquery :kind exists :correlated :type Boolean :null f) (subquery :kind exists :correlated :type Boolean :null f) :type Boolean :null f) :out ((id Integer :null f :alias users :tid 1 :cid 1) (name VarChar :null t :alias users :tid 1 :cid 2))
